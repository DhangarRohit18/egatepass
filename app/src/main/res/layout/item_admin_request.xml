<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="10dp"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="?attr/colorSurface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivAvatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_person_placeholder"
            app:shapeAppearanceOverlay="@style/EGP.Circle" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvStudentName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Student Name"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            app:layout_constraintStart_toEndOf="@id/ivAvatar"
            app:layout_constraintTop_toTopOf="@id/ivAvatar"
            app:layout_constraintEnd_toStartOf="@id/tvStatus"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:maxLines="1"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvEnrollment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Enrollment"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintStart_toStartOf="@id/tvStudentName"
            app:layout_constraintTop_toBottomOf="@id/tvStudentName"
            app:layout_constraintEnd_toEndOf="@id/tvStudentName"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PENDING"
            android:textStyle="bold"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="@id/tvStudentName"
            app:layout_constraintEnd_toEndOf="parent"
            android:background="@drawable/bg_status_pending"
            android:textColor="@android:color/white"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvReason"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Reason"
            app:layout_constraintStart_toStartOf="@id/tvStudentName"
            app:layout_constraintTop_toBottomOf="@id/tvEnrollment"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"
            android:maxLines="2"
            android:ellipsize="end"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvDates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="03 Nov 2025 • Out 10:00"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="?attr/colorPrimary"
            app:layout_constraintStart_toStartOf="@id/tvReason"
            app:layout_constraintTop_toBottomOf="@id/tvReason"
            android:layout_marginTop="6dp"/>

        <!-- Buttons -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetails"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="View"
            app:layout_constraintStart_toStartOf="@id/tvDates"
            app:layout_constraintTop_toBottomOf="@id/tvDates"
            android:layout_marginTop="10dp"
            style="@style/Widget.Material3.Button.TextButton"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReject"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:text="Reject"
            app:layout_constraintEnd_toStartOf="@+id/btnAccept"
            app:layout_constraintHorizontal_bias="0.142"
            app:layout_constraintStart_toEndOf="@id/btnDetails"
            app:layout_constraintTop_toTopOf="@id/btnDetails" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAccept"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Approve"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnDetails"
            style="@style/Widget.Material3.Button"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
