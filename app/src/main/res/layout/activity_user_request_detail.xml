<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Request Details"
            style="@style/AppTextTitle"/>
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Status (header) -->
                    <TextView
                        android:id="@+id/tvDetailStatus"
                        style="@style/AppTextTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Status: Pending" />

                    <!-- Reason -->
                    <TextView
                        android:id="@+id/tvDetailReason"
                        style="@style/AppTextBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Reason: Medical" />

                    <!-- Date (Enrollment in your Java) -->
                    <TextView
                        android:id="@+id/tvDetailDate"
                        style="@style/AppTextBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Date: 2025-11-01" />

                    <TextView
                        android:id="@+id/tvDetailOut"
                        style="@style/AppTextBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Out: 10:00" />

                    <TextView
                        android:id="@+id/tvDetailIn"
                        style="@style/AppTextBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="In: 18:00" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Generate QR Button -->
            <Button
                android:id="@+id/btnGenerateQr"
                style="@style/AppButton"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="8dp"
                android:text="Generate / Show QR" />

            <!-- QR Code Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardQrImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <ImageView
                    android:id="@+id/ivQr"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="Generated QR Code" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
