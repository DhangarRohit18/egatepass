<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <style name="Theme.EGatePass" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_theme_primary</item>
        <item name="colorOnPrimary">@color/md_theme_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_primary_container</item>
        <item name="colorSecondary">@color/md_theme_secondary</item>
        <item name="android:statusBarColor">@color/md_theme_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="materialButtonStyle">@style/Widget.EGatepass.Button</item>
        <item name="materialCardViewStyle">@style/Widget.EGatepass.Card</item>
        <item name="android:fontFamily">@font/roboto_regular</item>
    </style>

    <style name="Theme.EGatePass.AppBarOverlay" parent="ThemeOverlay.Material3.Dark.ActionBar" />

    <!-- Text Styles -->
    <style name="AppTextTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#222222</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">16dp</item>
    </style>
    <style name="AppTextBody" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">#444444</item>
        <item name="android:padding">12dp</item>
    </style>
    <style name="AppTextBody.Small" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#666666</item>
        <item name="android:padding">8dp</item>
    </style>

    <!-- Buttons and Cards -->
    <style name="AppButton" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/button_filled_primary</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">14dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="AppButtonSuccess" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/button_filled_success</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">14dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="AppButton.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:strokeColor">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Cards and chips -->
    <style name="EGP.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
        <item name="android:foreground">?selectableItemBackground</item>
    </style>
    <style name="EGP.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/black</item>
        <item name="chipCornerRadius">14dp</item>
    </style>
    <style name="EGP.Circle" parent="ShapeAppearance.Material3.Corner.None">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="Widget.EGatepass.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:height">48dp</item>
        <item name="android:fontFamily">@font/roboto_medium</item>
    </style>
    <style name="Widget.EGatepass.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">4dp</item>
    </style>
</resources>
